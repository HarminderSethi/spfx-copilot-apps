---
import { ArrowLeft, ArrowRight, CalendarDays, Download, ExternalLink } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { catalog, sitePath, type ComponentRecord } from '../../lib/catalog';

export function getStaticPaths() {
  return catalog.components.map((component) => ({
    params: { slug: component.slug },
    props: { component },
  }));
}

interface Props {
  component: ComponentRecord;
}

const { component } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(`${component.updatedAt}T00:00:00Z`));
---

<BaseLayout title={component.title} description={component.shortDescription} image={component.preview.src960}>
  <div class="container breadcrumb"><a href={sitePath('/')}><ArrowLeft size={16} aria-hidden="true" /> All components</a></div>

  <section class="detail-hero container">
    <div class="detail-hero__copy">
      <p class="eyebrow">Copilot Component</p>
      <h1>{component.title}</h1>
      <p class="detail-hero__summary">{component.shortDescription}</p>
      <div class="action-row">
        <a class="button button--primary" href={component.downloadUrl}>
          <Download size={17} aria-hidden="true" /> Download sample
        </a>
        <a class="button button--secondary" href={component.sourceUrl}>
          View source <ExternalLink size={16} aria-hidden="true" />
        </a>
      </div>
      <div class="detail-authors">
        {component.authors.map((author) => (
          <a href={`https://github.com/${author.gitHubAccount}`}>
            <img src={author.pictureUrl} alt="" width="36" height="36" />
            <span>{author.name}</span>
          </a>
        ))}
      </div>
    </div>
    <figure class="detail-preview">
      <picture>
        <source srcset={`${sitePath(component.preview.src640)} 640w, ${sitePath(component.preview.src960)} 960w`} type="image/webp" />
        <img src={sitePath(component.preview.src960)} alt={component.preview.alt} width={component.preview.width} height={component.preview.height} />
      </picture>
    </figure>
  </section>

  <section class="facts-band">
    <dl class="container component-facts">
      <div><dt>Updated</dt><dd><CalendarDays size={16} aria-hidden="true" /> {formattedDate}</dd></div>
      <div><dt>Built with</dt><dd>{component.clientTechnology}</dd></div>
      <div><dt>SPFx version</dt><dd>{component.spfxVersion}</dd></div>
      <div><dt>Products</dt><dd>{component.products.join(', ')}</dd></div>
    </dl>
  </section>

  <section class="content-section container detail-overview">
    <div class="section-heading"><div><p class="eyebrow">Overview</p><h2>What this sample demonstrates</h2></div></div>
    <div class="prose-lead">
      {component.longDescription.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  {component.gallery.length > 1 && (
    <section class="content-section content-section--tint">
      <div class="container">
        <div class="section-heading"><div><p class="eyebrow">Gallery</p><h2>See the component in action</h2></div></div>
        <div class="media-gallery">
          {component.gallery.map((image) => (
            <a href={image.url} aria-label={`Open full image: ${image.alt}`}>
              <img src={image.url} alt={image.alt} loading="lazy" decoding="async" />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="content-section container detail-documentation">
    <div class="section-heading">
      <div><p class="eyebrow">Documentation</p><h2>Setup and implementation</h2></div>
      <a class="text-link" href={component.sourceUrl}>README on GitHub <ArrowRight size={17} aria-hidden="true" /></a>
    </div>
    <div class="readme-content" set:html={component.readmeHtml} />
  </section>
</BaseLayout>