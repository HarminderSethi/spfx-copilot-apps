---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { catalog, sitePath } from '../lib/catalog';

const contributorSamples = new Map(
  catalog.contributors.map((author) => [
    author.gitHubAccount.toLocaleLowerCase('en-US'),
    catalog.components.filter((component) => component.authors.some(
      (candidate) => candidate.gitHubAccount.toLocaleLowerCase('en-US') === author.gitHubAccount.toLocaleLowerCase('en-US'),
    )),
  ]),
);
---

<BaseLayout title="Contributors" description="Meet the community members building Copilot Components.">
  <header class="page-heading container">
    <p class="eyebrow">Community</p>
    <h1>Contributors</h1>
    <p>Meet the people turning real business scenarios into reusable Copilot Components.</p>
  </header>

  <section class="content-section content-section--tint">
    <div class="container recognition-band">
      <img src={sitePath('/generated/brand/contributor-badge.png')} alt="SharePoint community contributor badge" width="220" height="220" />
      <div><p class="eyebrow">Community recognition</p><h2>Sharing is caring</h2><p>Community contributions help others learn, prototype, and deliver better Microsoft 365 experiences.</p><a class="text-link" href="https://aka.ms/community/recognition">Learn about community recognition <ArrowRight size={17} aria-hidden="true" /></a></div>
    </div>
  </section>

  <section class="content-section container">
    <div class="contributor-grid">
      {catalog.contributors.map((author) => (
        <article class="contributor-card">
          <img src={author.pictureUrl} alt="" width="72" height="72" loading="lazy" />
          <div><h2>{author.name}</h2><a href={`https://github.com/${author.gitHubAccount}`}>@{author.gitHubAccount}</a><p>{contributorSamples.get(author.gitHubAccount.toLocaleLowerCase('en-US'))?.length} component samples</p></div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>