{
  "name": "zava-innovation-portfolio",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.14.0 < 23.0.0"
  },
  "scripts": {
    "build": "npm run validate && heft test --clean --production && heft package-solution --production && npm run check:generated-plugin && npm run check:package-output",
    "configure:intents": "node scripts/configure-intents.mjs",
    "build:visual": "node scripts/build-visual-harness.mjs",
    "capture:visual": "npm run build:visual && node scripts/capture-publication-visuals.mjs",
    "generate:agent-icons": "pwsh -NoProfile -File scripts/generate-agent-icons.ps1",
    "check:agent-icons": "pwsh -NoProfile -File scripts/generate-agent-icons.ps1 -Check",
    "generate:assets": "node scripts/generate-asset-provenance.mjs",
    "validate:assets": "node scripts/generate-asset-provenance.mjs --check",
    "validate:intents": "node scripts/validate-intents.mjs",
    "generate:routing-matrix": "node scripts/generate-routing-matrix.mjs",
    "check:routing-matrix": "node scripts/generate-routing-matrix.mjs --check",
    "check:gallery": "node scripts/validate-gallery-assets.mjs",
    "check:generated-plugin": "node scripts/validate-generated-ai-plugin.mjs",
    "check:package-output": "node scripts/validate-package-output.mjs",
    "check:diff": "git diff --check",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "validate": "npm run validate:intents && npm run check:agent-icons && npm run validate:assets && npm run check:routing-matrix && npm run check:gallery && npm run audit:production && npm run check:diff",
    "clean": "heft clean",
    "eject-webpack": "heft eject-webpack",
    "start": "heft start --clean"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.6",
    "@fluentui/react-icons": "2.0.337",
    "@griffel/react": "1.7.7",
    "@microsoft/sp-copilot-component": "1.24.0-beta.2",
    "@microsoft/sp-lodash-subset": "1.24.0-beta.2",
    "d3-geo": "3.1.1",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "topojson-client": "3.1.0",
    "tslib": "2.3.1",
    "world-atlas": "2.0.2",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.24.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.24.0-beta.2",
    "@microsoft/eslint-plugin-spfx": "1.24.0-beta.2",
    "@microsoft/spfx-heft-plugins": "1.24.0-beta.2",
    "@microsoft/spfx-web-build-rig": "1.24.0-beta.2",
    "@rushstack/heft": "1.2.17",
    "@types/d3-geo": "3.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "@types/topojson-client": "3.1.5",
    "@types/webpack-env": "~1.15.2",
    "css-loader": "~7.1.2",
    "esbuild": "0.25.9",
    "eslint": "9.37.0",
    "playwright": "1.62.1",
    "typescript": "~5.8.0",
    "unzipper": "0.12.3"
  },
  "overrides": {
    "@rushstack/heft": "1.2.17",
    "fast-uri": "3.1.6"
  }
}
