{
  "name": "zava-procurement-command-center",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.14.0 < 23.0.0"
  },
  "scripts": {
    "build": "npm run validate && heft test --clean --production && heft package-solution --production && npm run check:generated-plugin && npm run check:package-output",
    "configure:intents": "node scripts/configure-intent-components.mjs",
    "check:intents": "node scripts/validate-intent-components.mjs",
    "build:visual": "node scripts/build-visual-harness.mjs",
    "capture:visual": "npm run build:visual && node scripts/capture-gallery-assets.mjs",
    "check:gallery": "node scripts/validate-gallery-assets.mjs",
    "generate:assets": "node scripts/generate-asset-provenance.mjs",
    "check:media": "node scripts/generate-asset-provenance.mjs --check",
    "generate:routing-matrix": "node scripts/generate-routing-matrix.mjs",
    "check:routing-matrix": "node scripts/generate-routing-matrix.mjs --check",
    "check:publication": "node scripts/validate-publication-assets.mjs",
    "check:generated-plugin": "node scripts/validate-generated-ai-plugin.mjs",
    "check:package-output": "node scripts/validate-package-output.mjs",
    "validate": "npm run check:intents && npm run check:routing-matrix && npm run check:gallery && npm run check:media && npm run check:publication && heft test --clean",
    "clean": "heft clean",
    "eject-webpack": "heft eject-webpack",
    "start": "heft start --clean"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.6",
    "@fluentui/react-icons": "2.0.314",
    "@griffel/react": "1.7.7",
    "@microsoft/sp-copilot-component": "1.24.0-beta.3",
    "@microsoft/sp-http": "1.24.0-beta.3",
    "@microsoft/sp-lodash-subset": "1.24.0-beta.3",
    "d3-force": "3.0.0",
    "d3-geo": "3.1.1",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tslib": "2.3.1",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.24.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.24.0-beta.3",
    "@microsoft/eslint-plugin-spfx": "1.24.0-beta.3",
    "@microsoft/spfx-heft-plugins": "1.24.0-beta.3",
    "@microsoft/spfx-web-build-rig": "1.24.0-beta.3",
    "@rushstack/heft": "1.2.22",
    "@types/d3-force": "3.0.10",
    "@types/d3-geo": "3.1.0",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.7",
    "@types/jest": "30.0.0",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@types/webpack-env": "~1.15.2",
    "css-loader": "~7.1.2",
    "esbuild": "0.25.9",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "playwright": "1.55.0",
    "typescript": "~5.8.0",
    "unzipper": "0.12.3"
  },
  "overrides": {
    "@rushstack/heft": "1.2.22",
    "qs": ">=6.15.2",
    "uri-js": "4.4.1",
    "uuid": ">=11.1.1"
  },
  "resolutions": {
    "@types/react": "18.2.79"
  }
}
